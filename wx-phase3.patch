@@ -0,0 +1,49 @@
+package wx.grib;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Loads the eccodes-generated fixtures in src/test/resources/grib (see phase3/make_fixtures.py). */
+final class Fixtures {
+
+  static final Path DIR = Path.of("src/test/resources/grib");
+
+  /** The HRRR CONUS grid exactly as eccodes wrote it for hrrr_nearest.csv. */
+  static final LambertConformal HRRR = new LambertConformal(
+      1799, 1059, 21.138, 237.28, 262.5, 38.5, 38.5, 3000.0, 3000.0, 6_371_229.0, true);
+
+  private Fixtures() {}
+
+  static byte[] smallGrib() throws IOException {
+    return Files.readAllBytes(DIR.resolve("small.grib2"));
+  }
+
+  /** CSV with a header row and no quoted fields (the fixtures contain none). */
+  static List<Map<String, String>> csv(String name) throws IOException {
+    List<String> lines = Files.readAllLines(DIR.resolve(name));
+    String[] head = lines.get(0).split(",", -1);
+    List<Map<String, String>> rows = new ArrayList<>();
+    for (String line : lines.subList(1, lines.size())) {
+      if (line.isBlank()) {
+        continue;
+      }
+      String[] f = line.split(",", -1);
+      Map<String, String> row = new LinkedHashMap<>();
+      for (int k = 0; k < head.length; k++) {
+        row.put(head[k], f[k]);
+      }
+      rows.add(row);
+    }
+    return rows;
+  }
+
+  /** Longitude difference wrapped to [-180, 180). */
+  static double lonDiff(double a, double b) {
+    return LambertConformal.deltaLon(a, b);
+  }
+}
diff --git a/pipeline/src/test/java/wx/grib/Grib2ScannerTest.java b/pipeline/src/test/java/wx/grib/Grib2ScannerTest.java
new file mode 100644
index 0000000..073923c
--- /dev/null
+++ b/pipeline/src/test/java/wx/grib/Grib2ScannerTest.java
@@ -0,0 +1,94 @@
+package wx.grib;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.time.LocalDateTime;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+
+class Grib2ScannerTest {
+
+  @Test
+  void signAndMagnitudeIsNotTwosComplement() {
+    byte[] b = {(byte) 0x80, 0x00, 0x00, 0x01, (byte) 0x80, 0x0B};
+    assertEquals(-1L, Octets.s4(b, 0, 1));
+    assertEquals(-11, Octets.s2(b, 0, 5));
+    // Read as two's complement, the same bytes would be a large negative number.
+    assertEquals(-2147483647, (int) Octets.u4(b, 0, 1));
+  }
+
+  @Test
+  void metadataMatchesEccodes() throws Exception {
+    List<Grib2Message> msgs = Grib2Scanner.scan(Fixtures.smallGrib());
+    assertEquals(5, msgs.size());
+    Map<String, Map<String, String>> firstRowPerMsg = new LinkedHashMap<>();
+    for (Map<String, String> r : Fixtures.csv("small_expected.csv")) {
+      firstRowPerMsg.putIfAbsent(r.get("msg"), r);
+    }
+    for (int k = 0; k < msgs.size(); k++) {
+      Grib2Message m = msgs.get(k);
+      Map<String, String> e = firstRowPerMsg.get(String.valueOf(k + 1));
+      assertEquals(Integer.parseInt(e.get("discipline")), m.discipline(), "discipline msg " + (k + 1));
+      assertEquals(Integer.parseInt(e.get("parameterCategory")), m.category(), "category msg " + (k + 1));
+      assertEquals(Integer.parseInt(e.get("parameterNumber")), m.number(), "number msg " + (k + 1));
+      assertEquals(Integer.parseInt(e.get("dataRepresentationTemplateNumber")), m.drsTemplate());
+      assertEquals(Integer.parseInt(e.get("binaryScaleFactor")), m.binaryScale(), "E msg " + (k + 1));
+      assertEquals(Integer.parseInt(e.get("decimalScaleFactor")), m.decimalScale(), "D msg " + (k + 1));
+      assertEquals(Integer.parseInt(e.get("bitsPerValue")), m.bitsPerValue(), "bits msg " + (k + 1));
+      assertEquals((float) Double.parseDouble(e.get("referenceValue")), m.referenceValue(), 0f, "R msg " + (k + 1));
+      assertEquals(Integer.parseInt(e.get("Nx")), m.grid().nx);
+      assertEquals(Integer.parseInt(e.get("Ny")), m.grid().ny);
+      assertEquals(LocalDateTime.of(2026, 10, 14, 12, 0), m.referenceTime());
+      assertEquals(Long.parseLong(e.get("forecastTime")), m.forecastTime());
+    }
+  }
+
+  @Test
+  void identifiesTheFiveHrrrVariables() throws Exception {
+    List<HrrrVariable> vars = Grib2Scanner.scan(Fixtures.smallGrib()).stream()
+        .map(Grib2Message::variable).toList();
+    assertEquals(List.of(HrrrVariable.TMP_2M, HrrrVariable.DPT_2M, HrrrVariable.UGRD_10M,
+        HrrrVariable.VGRD_10M, HrrrVariable.PRES_SFC), vars);
+  }
+
+  @Test
+  void readsGridFlagsAndEarth() throws Exception {
+    LambertConformal g = Grib2Scanner.scan(Fixtures.smallGrib()).get(0).grid();
+    assertEquals(6_371_229.0, g.earthRadius, 0.0);
+    assertTrue(g.uvRelativeToGrid, "HRRR-style winds are grid-relative");
+    assertEquals(262.5, g.lov, 1e-9);
+    assertEquals(38.5, g.latin1, 1e-9);
+    assertEquals(3000.0, g.dx, 1e-9);
+  }
+
+  @Test
+  void packingStepComesFromScaleFactors() throws Exception {
+    Grib2Message t = Grib2Scanner.scan(Fixtures.smallGrib()).get(0);
+    assertEquals(Math.pow(2, t.binaryScale()) / Math.pow(10, t.decimalScale()), t.packingStep(), 0.0);
+  }
+
+  @Test
+  void truncatedFileIsRejectedWithAReason() throws Exception {
+    byte[] all = Fixtures.smallGrib();
+    byte[] cut = Arrays.copyOf(all, all.length - 100);
+    IllegalArgumentException e = assertThrows(IllegalArgumentException.class, () -> Grib2Scanner.scan(cut));
+    assertTrue(e.getMessage().contains("truncated"), e.getMessage());
+  }
+
+  @Test
+  void messagesAreContiguousAndCoverTheFile() throws Exception {
+    byte[] all = Fixtures.smallGrib();
+    List<Grib2Message> msgs = Grib2Scanner.scan(all);
+    long expected = 0;
+    for (Grib2Message m : msgs) {
+      assertEquals(expected, m.offset());
+      expected += m.length();
+    }
+    assertEquals(all.length, expected);
+  }
+}
diff --git a/pipeline/src/test/java/wx/grib/LambertConformalTest.java b/pipeline/src/test/java/wx/grib/LambertConformalTest.java
new file mode 100644
index 0000000..6f0aea6
--- /dev/null
+++ b/pipeline/src/test/java/wx/grib/LambertConformalTest.java
@@ -0,0 +1,119 @@
+package wx.grib;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.List;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+
+class LambertConformalTest {
+
+  /** eccodes computed every HRRR grid point's coordinates; we must land on the same cell. */
+  @Test
+  void nearestCellMatchesEccodesAcrossTheHrrrGrid() throws Exception {
+    List<Map<String, String>> rows = Fixtures.csv("hrrr_nearest.csv");
+    int checked = 0;
+    for (Map<String, String> r : rows) {
+      int[] ij = Fixtures.HRRR.nearest(Double.parseDouble(r.get("lat")), Double.parseDouble(r.get("lon")));
+      String where = r.get("name") + " " + r.get("lat") + "," + r.get("lon");
+      assertTrue(ij != null, "inside grid: " + where);
+      assertEquals(Integer.parseInt(r.get("i")), ij[0], "i for " + where);
+      assertEquals(Integer.parseInt(r.get("j")), ij[1], "j for " + where);
+      assertEquals(Integer.parseInt(r.get("index")), Fixtures.HRRR.flatIndex(ij[0], ij[1]), "index for " + where);
+      checked++;
+    }
+    assertTrue(checked > 350, "checked " + checked + " points");
+  }
+
+  /** Inverse projection: grid point coordinates agree with eccodes to well under a metre. */
+  @Test
+  void gridPointCoordinatesMatchEccodes() throws Exception {
+    for (Map<String, String> r : Fixtures.csv("hrrr_nearest.csv")) {
+      double[] ll = Fixtures.HRRR.latLon(Integer.parseInt(r.get("i")), Integer.parseInt(r.get("j")));
+      double elat = Double.parseDouble(r.get("grid_lat"));
+      double elon = Double.parseDouble(r.get("grid_lon"));
+      assertEquals(elat, ll[0], 1e-6, "lat for " + r.get("name"));
+      assertEquals(0.0, Fixtures.lonDiff(ll[1], elon), 1e-6, "lon for " + r.get("name"));
+    }
+  }
+
+  @Test
+  void stationsLandOnTheExpectedHrrrCells() throws Exception {
+    Map<String, int[]> expected = Map.of(
+        "KIAH", new int[] {969, 213}, "KHOU", new int[] {972, 201},
+        "KSGR", new int[] {959, 199}, "KDEN", new int[] {695, 588});
+    for (Map<String, String> r : Fixtures.csv("hrrr_nearest.csv")) {
+      int[] want = expected.get(r.get("name"));
+      if (want != null) {
+        int[] got = Fixtures.HRRR.nearest(Double.parseDouble(r.get("lat")), Double.parseDouble(r.get("lon")));
+        assertEquals(want[0], got[0], r.get("name"));
+        assertEquals(want[1], got[1], r.get("name"));
+      }
+    }
+  }
+
+  @Test
+  void pointsOutsideTheGridReturnNull() {
+    assertEquals(null, Fixtures.HRRR.nearest(64.8, -147.7));   // Fairbanks: not on CONUS HRRR
+    assertEquals(null, Fixtures.HRRR.nearest(19.7, -155.1));   // Hawaii
+  }
+
+  @Test
+  void smallGridNearestMatchesEccodesFindNearest() throws Exception {
+    LambertConformal g = Grib2Scanner.scan(Fixtures.smallGrib()).get(0).grid();
+    for (Map<String, String> r : Fixtures.csv("small_expected.csv")) {
+      int[] ij = g.nearest(Double.parseDouble(r.get("lat")), Double.parseDouble(r.get("lon")));
+      assertEquals(Integer.parseInt(r.get("index")), g.flatIndex(ij[0], ij[1]), r.get("station"));
+      assertEquals(Double.parseDouble(r.get("distance_km")),
+          g.distanceKm(Double.parseDouble(r.get("lat")), Double.parseDouble(r.get("lon")),
+              g.latLon(ij[0], ij[1])[0], g.latLon(ij[0], ij[1])[1]), 0.01, r.get("station"));
+    }
+  }
+
+  /**
+   * Wind rotation checked against geometry, not against the formula: the grid's +j axis at a point
+   * is the direction to the next grid point north in j. A wind blowing along +j (u=0, v=1 grid-
+   * relative) must come out pointing along that bearing after rotation.
+   */
+  @Test
+  void rotationTurnsGridNorthOntoItsTrueBearing() {
+    LambertConformal g = Fixtures.HRRR;
+    int[][] cells = {{969, 213}, {695, 588}, {10, 1000}, {1790, 1000}, {899, 500}};
+    for (int[] c : cells) {
+      double[] a = g.latLon(c[0], c[1]);
+      double[] b = g.latLon(c[0], c[1] + 1);
+      double bearing = bearing(a[0], a[1], b[0], b[1]);
+      double[] uv = g.toEarthRelative(0.0, 1.0, a[1]);
+      double towards = Math.toDegrees(Math.atan2(uv[0], uv[1]));
+      assertEquals(0.0, angleDiff(bearing, towards), 0.01, "cell " + c[0] + "," + c[1]);
+      assertEquals(1.0, Math.hypot(uv[0], uv[1]), 1e-12, "speed is unchanged");
+    }
+  }
+
+  @Test
+  void noRotationAlongTheCentralMeridian() {
+    double[] uv = Fixtures.HRRR.toEarthRelative(3.0, 4.0, -97.5);
+    assertEquals(3.0, uv[0], 1e-12);
+    assertEquals(4.0, uv[1], 1e-12);
+  }
+
+  @Test
+  void rotationAtTheGridCornersIsLarge() {
+    double[] corner = Fixtures.HRRR.latLon(1798, 1058);
+    double[] uv = Fixtures.HRRR.toEarthRelative(0.0, 1.0, corner[1]);
+    double turned = Math.abs(Math.toDegrees(Math.atan2(uv[0], uv[1])));
+    assertTrue(turned > 20.0, "north-east corner turned by " + turned + " degrees");
+  }
+
+  private static double bearing(double lat1, double lon1, double lat2, double lon2) {
+    double p1 = Math.toRadians(lat1), p2 = Math.toRadians(lat2), dl = Math.toRadians(lon2 - lon1);
+    return Math.toDegrees(Math.atan2(Math.sin(dl) * Math.cos(p2),
+        Math.cos(p1) * Math.sin(p2) - Math.sin(p1) * Math.cos(p2) * Math.cos(dl)));
+  }
+
+  private static double angleDiff(double a, double b) {
+    double d = (a - b) % 360.0;
+    return d > 180 ? d - 360 : d < -180 ? d + 360 : d;
+  }
+}
diff --git a/pipeline/src/test/java/wx/grib/NetcdfUnpackerTest.java b/pipeline/src/test/java/wx/grib/NetcdfUnpackerTest.java
new file mode 100644
index 0000000..43fc685
--- /dev/null
+++ b/pipeline/src/test/java/wx/grib/NetcdfUnpackerTest.java
@@ -0,0 +1,75 @@
+package wx.grib;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+
+/**
+ * netCDF-Java against eccodes on the same file. Both decode the same packed integers, so the only
+ * expected difference is float rounding, far below half a packing step. That half step is the
+ * tolerance: it is derived from the file (R, E, D), not picked by hand.
+ */
+class NetcdfUnpackerTest {
+
+  @Test
+  void valuesAtStationsMatchEccodes() throws Exception {
+    byte[] data = Fixtures.smallGrib();
+    List<Grib2Message> msgs = Grib2Scanner.scan(data);
+    try (NetcdfUnpacker u = new NetcdfUnpacker(data, msgs)) {
+      for (Map<String, String> r : Fixtures.csv("small_expected.csv")) {
+        Grib2Message m = msgs.get(Integer.parseInt(r.get("msg")) - 1);
+        float[] v = u.unpack(m);
+        double tol = m.packingStep() / 2;
+        assertEquals(Double.parseDouble(r.get("value")), v[Integer.parseInt(r.get("index"))], tol,
+            r.get("station") + " msg " + r.get("msg"));
+      }
+    }
+  }
+
+  @Test
+  void wholeFieldStatisticsMatchEccodes() throws Exception {
+    byte[] data = Fixtures.smallGrib();
+    List<Grib2Message> msgs = Grib2Scanner.scan(data);
+    Map<String, Map<String, String>> perMsg = new HashMap<>();
+    for (Map<String, String> r : Fixtures.csv("small_expected.csv")) {
+      perMsg.putIfAbsent(r.get("msg"), r);
+    }
+    try (NetcdfUnpacker u = new NetcdfUnpacker(data, msgs)) {
+      for (int k = 0; k < msgs.size(); k++) {
+        Grib2Message m = msgs.get(k);
+        Map<String, String> e = perMsg.get(String.valueOf(k + 1));
+        float[] v = u.unpack(m);
+        assertEquals(m.grid().nx * m.grid().ny, v.length);
+        double min = Double.MAX_VALUE, max = -Double.MAX_VALUE, sum = 0;
+        for (float x : v) {
+          min = Math.min(min, x);
+          max = Math.max(max, x);
+          sum += x;
+        }
+        double tol = m.packingStep() / 2;
+        assertEquals(Double.parseDouble(e.get("vmin")), min, tol, "min msg " + (k + 1));
+        assertEquals(Double.parseDouble(e.get("vmax")), max, tol, "max msg " + (k + 1));
+        // the sum of 2400 values may drift by up to one half-step per value
+        assertEquals(Double.parseDouble(e.get("vsum")), sum, tol * v.length, "sum msg " + (k + 1));
+      }
+    }
+  }
+
+  @Test
+  void endToEndSamplingWithRealUnpacking() throws Exception {
+    byte[] data = Fixtures.smallGrib();
+    List<Grib2Message> msgs = Grib2Scanner.scan(data);
+    try (NetcdfUnpacker u = new NetcdfUnpacker(data, msgs)) {
+      List<StationPoints.Row> rows = StationPoints.extract(msgs, u::unpack, Station.DEFAULT);
+      assertEquals(3, rows.size(), "three Houston stations; KDEN is off the small grid");
+      for (StationPoints.Row row : rows) {
+        assertTrue(row.t2mC() > 0 && row.t2mC() < 40, row.station() + " t2m " + row.t2mC());
+        assertTrue(row.psfcHpa() > 980 && row.psfcHpa() < 1040, row.station() + " psfc " + row.psfcHpa());
+      }
+    }
+  }
+}
diff --git a/pipeline/src/test/java/wx/grib/StationPointsTest.java b/pipeline/src/test/java/wx/grib/StationPointsTest.java
new file mode 100644
index 0000000..9e0d631
--- /dev/null
+++ b/pipeline/src/test/java/wx/grib/StationPointsTest.java
@@ -0,0 +1,109 @@
+package wx.grib;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Sampling logic with a stand-in unpacker: each array holds NaN everywhere except the cells eccodes
+ * reported for the stations, which hold eccodes' values. Picking any other cell yields null.
+ */
+class StationPointsTest {
+
+  private static final List<Station> HOUSTON = Station.DEFAULT.subList(0, 3);
+
+  private static Map<Integer, float[]> eccodesArrays() throws Exception {
+    Map<Integer, float[]> arrays = new HashMap<>();
+    for (Map<String, String> r : Fixtures.csv("small_expected.csv")) {
+      int msg = Integer.parseInt(r.get("msg"));
+      float[] a = arrays.computeIfAbsent(msg, k -> {
+        float[] f = new float[60 * 40];
+        Arrays.fill(f, Float.NaN);
+        return f;
+      });
+      a[Integer.parseInt(r.get("index"))] = (float) Double.parseDouble(r.get("value"));
+    }
+    return arrays;
+  }
+
+  private static List<StationPoints.Row> rows() throws Exception {
+    List<Grib2Message> msgs = Grib2Scanner.scan(Fixtures.smallGrib());
+    Map<Integer, float[]> arrays = eccodesArrays();
+    return StationPoints.extract(msgs, m -> arrays.get(msgs.indexOf(m) + 1), HOUSTON);
+  }
+
+  @Test
+  void picksEccodesCellAndValueForEveryStationAndField() throws Exception {
+    List<StationPoints.Row> rows = rows();
+    assertEquals(3, rows.size(), "one valid time x three stations");
+    Map<String, Map<String, String>> tmp = new HashMap<>();
+    for (Map<String, String> r : Fixtures.csv("small_expected.csv")) {
+      if (r.get("msg").equals("1")) {
+        tmp.put(r.get("station"), r);
+      }
+    }
+    for (StationPoints.Row row : rows) {
+      Map<String, String> e = tmp.get(row.station());
+      assertEquals(Integer.parseInt(e.get("i")), row.i(), row.station());
+      assertEquals(Integer.parseInt(e.get("j")), row.j(), row.station());
+      for (HrrrVariable v : HrrrVariable.values()) {
+        assertTrue(row.raw().get(v) != null, row.station() + " " + v + " sampled the wrong cell");
+      }
+      assertEquals(Double.parseDouble(e.get("value")), row.raw().get(HrrrVariable.TMP_2M), 1e-4);
+      assertEquals(Double.parseDouble(e.get("value")) - 273.15, row.t2mC(), 1e-4);
+      assertEquals(Double.parseDouble(e.get("distance_km")), row.distanceKm(), 0.01);
+    }
+  }
+
+  @Test
+  void derivedWindIsEarthRelative() throws Exception {
+    for (StationPoints.Row row : rows()) {
+      double u = row.raw().get(HrrrVariable.UGRD_10M);
+      double v = row.raw().get(HrrrVariable.VGRD_10M);
+      assertEquals(Math.hypot(u, v), row.windSpeed(), 1e-9, "rotation preserves speed");
+      double unrotated = StationPoints.directionFrom(u, v);
+      double diff = Math.abs(((row.windDirFrom() - unrotated) % 360 + 540) % 360 - 180);
+      assertTrue(diff > 0.5 && diff < 3.0,
+          row.station() + ": Houston is ~2 degrees east of LoV, rotation should be ~1-2 degrees, was " + diff);
+    }
+  }
+
+  @Test
+  void directionConventionIsWhereTheWindComesFrom() {
+    assertEquals(0.0, StationPoints.directionFrom(0, -5), 1e-9);    // blowing south: from the north
+    assertEquals(270.0, StationPoints.directionFrom(5, 0), 1e-9);   // blowing east: from the west
+    assertEquals(90.0, StationPoints.directionFrom(-5, 0), 1e-9);
+    assertNull(StationPoints.directionFrom(0, 0));
+  }
+
+  @Test
+  void stationsOffTheGridAreSkipped() throws Exception {
+    List<Grib2Message> msgs = Grib2Scanner.scan(Fixtures.smallGrib());
+    Map<Integer, float[]> arrays = eccodesArrays();
+    List<StationPoints.Row> rows = StationPoints.extract(msgs, m -> arrays.get(msgs.indexOf(m) + 1),
+        List.of(new Station("KDEN", 39.86, -104.67)));   // Denver is not on the small Houston grid
+    assertTrue(rows.isEmpty());
+  }
+
+  @Test
+  void wrongLengthUnpackIsRejected() throws Exception {
+    List<Grib2Message> msgs = Grib2Scanner.scan(Fixtures.smallGrib());
+    assertThrows(IllegalArgumentException.class,
+        () -> StationPoints.extract(msgs, m -> new float[10], HOUSTON));
+  }
+
+  @Test
+  void parsesStationSpec() {
+    List<Station> s = Station.parse("KABC:30.5:-97.25,KXYZ:31:-96");
+    assertEquals(2, s.size());
+    assertEquals(-97.25, s.get(0).lon(), 0.0);
+    assertEquals(Station.DEFAULT, Station.parse(""));
+  }
+}
