diff --git a/pipeline/src/main/java/wx/grib/Grib2Message.java b/pipeline/src/main/java/wx/grib/Grib2Message.java
new file mode 100644
index 0000000..09a8b29
--- /dev/null
+++ b/pipeline/src/main/java/wx/grib/Grib2Message.java
@@ -0,0 +1,64 @@
+package wx.grib;
+
+import java.io.Serializable;
+import java.time.LocalDateTime;
+
+/**
+ * Metadata for one GRIB2 message, read directly from its sections. The data values are unpacked
+ * elsewhere (netCDF-Java in the pipeline); everything needed to interpret them is here.
+ *
+ * @param offset            byte offset of "GRIB" in the file
+ * @param length            total message length (Section 0)
+ * @param discipline        Section 0 octet 7 (0 = meteorological)
+ * @param referenceTime     Section 1 reference time, UTC
+ * @param category          Section 4 parameter category
+ * @param number            Section 4 parameter number
+ * @param surfaceType       Section 4 type of first fixed surface (103 = height above ground, 1 = surface)
+ * @param surfaceValue      first fixed surface value in its units (metres for 103), NaN if missing
+ * @param forecastTime      forecast time in {@code timeUnit} units
+ * @param timeUnit          Section 4 indicator of unit of time range (1 = hour)
+ * @param grid              Lambert conformal grid (template 3.30)
+ * @param drsTemplate       Section 5 data representation template (0 simple, 3 complex + spatial differencing)
+ * @param referenceValue    Section 5 R
+ * @param binaryScale       Section 5 E
+ * @param decimalScale      Section 5 D
+ * @param bitsPerValue      Section 5 number of bits
+ */
+public record Grib2Message(
+    long offset,
+    long length,
+    int discipline,
+    LocalDateTime referenceTime,
+    int category,
+    int number,
+    int surfaceType,
+    double surfaceValue,
+    long forecastTime,
+    int timeUnit,
+    LambertConformal grid,
+    int drsTemplate,
+    float referenceValue,
+    int binaryScale,
+    int decimalScale,
+    int bitsPerValue)
+    implements Serializable {
+
+  /** Valid time = reference time + forecast time (hours only; other units are rejected on parse). */
+  public LocalDateTime validTime() {
+    return referenceTime.plusHours(forecastTime);
+  }
+
+  /**
+   * Size of one packing step: values are stored as integers X with Y = (R + X * 2^E) / 10^D, so
+   * two values that differ by less than this were indistinguishable in the file. Parity between
+   * two decoders is judged against this, not against an arbitrary epsilon.
+   */
+  public double packingStep() {
+    return Math.scalb(1.0, binaryScale) / Math.pow(10, decimalScale);
+  }
+
+  /** The variable this message holds, or null if the pipeline does not use it. */
+  public HrrrVariable variable() {
+    return HrrrVariable.match(discipline, category, number, surfaceType, surfaceValue);
+  }
+}
diff --git a/pipeline/src/main/java/wx/grib/Grib2Scanner.java b/pipeline/src/main/java/wx/grib/Grib2Scanner.java
new file mode 100644
index 0000000..182e5ff
--- /dev/null
+++ b/pipeline/src/main/java/wx/grib/Grib2Scanner.java
@@ -0,0 +1,147 @@
+package wx.grib;
+
+import java.time.LocalDateTime;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Finds GRIB2 messages in a byte array and reads their metadata from Sections 0, 1, 3, 4 and 5.
+ *
+ * <p>This is the GRIB2 counterpart of the WXOBS copybook in Phase 1: the WMO templates fix every
+ * field's octet position, so each value is read at its documented offset. Only what the station
+ * pipeline needs is supported: grid template 3.30 (Lambert conformal), product template 4.0
+ * (analysis or forecast at a point in time), hourly forecast units. A message outside that set is
+ * rejected with the reason, not guessed at.
+ *
+ * <p>Octet numbers below are those of WMO GRIB2 Section and Template tables (1-based in section).
+ */
+public final class Grib2Scanner {
+
+  private Grib2Scanner() {}
+
+  /** All messages in {@code data}, in file order. */
+  public static List<Grib2Message> scan(byte[] data) {
+    List<Grib2Message> out = new ArrayList<>();
+    int pos = 0;
+    while (pos <= data.length - 16) {
+      if (!(data[pos] == 'G' && data[pos + 1] == 'R' && data[pos + 2] == 'I' && data[pos + 3] == 'B')) {
+        pos++;  // tolerate padding between messages
+        continue;
+      }
+      int edition = Octets.u1(data, pos, 8);
+      if (edition != 2) {
+        throw new IllegalArgumentException("GRIB edition " + edition + " at byte " + pos + "; only GRIB2 is supported");
+      }
+      long length = Octets.u8(data, pos, 9);
+      if (pos + length > data.length) {
+        throw new IllegalArgumentException("message at byte " + pos + " claims " + length
+            + " bytes but only " + (data.length - pos) + " remain (truncated download?)");
+      }
+      out.add(parse(data, pos, (int) length));
+      pos += (int) length;
+    }
+    return out;
+  }
+
+  static Grib2Message parse(byte[] b, int msg, int length) {
+    int discipline = Octets.u1(b, msg, 7);
+    LocalDateTime ref = null;
+    LambertConformal grid = null;
+    int category = -1, number = -1, surfaceType = -1, timeUnit = -1;
+    double surfaceValue = Double.NaN;
+    long forecastTime = 0;
+    int drsTemplate = -1, binaryScale = 0, decimalScale = 0, bits = 0;
+    float referenceValue = 0f;
+
+    int s = msg + 16;  // first section after Section 0
+    int end = msg + length - 4;
+    while (s < end) {
+      int secLen = (int) Octets.u4(b, s, 1);
+      int secNum = Octets.u1(b, s, 5);
+      switch (secNum) {
+        case 1 -> ref = LocalDateTime.of(Octets.u2(b, s, 13), Octets.u1(b, s, 15),
+            Octets.u1(b, s, 16), Octets.u1(b, s, 17), Octets.u1(b, s, 18), Octets.u1(b, s, 19));
+        case 3 -> grid = lambert(b, s);
+        case 4 -> {
+          int template = Octets.u2(b, s, 8);
+          if (template != 0) {
+            throw new IllegalArgumentException("product template 4." + template + " not supported");
+          }
+          category = Octets.u1(b, s, 10);
+          number = Octets.u1(b, s, 11);
+          timeUnit = Octets.u1(b, s, 18);
+          if (timeUnit != 1) {
+            throw new IllegalArgumentException("forecast time unit " + timeUnit + " not supported (need hours)");
+          }
+          forecastTime = Octets.u4(b, s, 19);
+          surfaceType = Octets.u1(b, s, 23);
+          if (!Octets.allOnes(b, s, 24, 5)) {
+            int scale = (byte) Octets.u1(b, s, 24);  // scale factor is a signed octet
+            surfaceValue = Octets.s4(b, s, 25) / Math.pow(10, scale);
+          }
+        }
+        case 5 -> {
+          drsTemplate = Octets.u2(b, s, 10);
+          referenceValue = Octets.ieee32(b, s, 12);
+          binaryScale = Octets.s2(b, s, 16);
+          decimalScale = Octets.s2(b, s, 18);
+          bits = Octets.u1(b, s, 20);
+        }
+        default -> { }  // 2 (local use), 6 (bitmap), 7 (data): not needed for metadata
+      }
+      if (secLen <= 0) {
+        throw new IllegalArgumentException("zero-length section " + secNum + " at byte " + s);
+      }
+      s += secLen;
+    }
+    if (ref == null || grid == null || category < 0 || drsTemplate < 0) {
+      throw new IllegalArgumentException("message at byte " + msg + " is missing a required section");
+    }
+    return new Grib2Message(msg, length, discipline, ref, category, number, surfaceType,
+        surfaceValue, forecastTime, timeUnit, grid, drsTemplate, referenceValue, binaryScale,
+        decimalScale, bits);
+  }
+
+  /** Grid template 3.30. Octets 15 onward per WMO Template 3.30. */
+  static LambertConformal lambert(byte[] b, int s) {
+    int template = Octets.u2(b, s, 13);
+    if (template != 30) {
+      throw new IllegalArgumentException("grid template 3." + template + " not supported (need 3.30 Lambert)");
+    }
+    double radius = earthRadius(b, s);
+    int nx = (int) Octets.u4(b, s, 31);
+    int ny = (int) Octets.u4(b, s, 35);
+    double la1 = Octets.s4(b, s, 39) * 1e-6;
+    double lo1 = Octets.u4(b, s, 43) * 1e-6;
+    int resComp = Octets.u1(b, s, 47);
+    double lov = Octets.u4(b, s, 52) * 1e-6;
+    double dx = Octets.u4(b, s, 56) * 1e-3;
+    double dy = Octets.u4(b, s, 60) * 1e-3;
+    int projCentre = Octets.u1(b, s, 64);
+    int scan = Octets.u1(b, s, 65);
+    double latin1 = Octets.s4(b, s, 66) * 1e-6;
+    double latin2 = Octets.s4(b, s, 70) * 1e-6;
+    if ((projCentre & 0x80) != 0) {
+      throw new IllegalArgumentException("south-pole Lambert projection not supported");
+    }
+    if (scan != 0x40) {
+      throw new IllegalArgumentException(String.format(
+          "scanning mode 0x%02X not supported (need 0x40: +i, +j, i consecutive)", scan));
+    }
+    return new LambertConformal(nx, ny, la1, lo1, lov, latin1, latin2, dx, dy, radius,
+        (resComp & 0x08) != 0);
+  }
+
+  /** Code Table 3.2, shape of the earth: the spherical cases. */
+  static double earthRadius(byte[] b, int s) {
+    int shape = Octets.u1(b, s, 15);
+    return switch (shape) {
+      case 0 -> 6_367_470.0;
+      case 6 -> 6_371_229.0;
+      case 8 -> 6_371_200.0;
+      case 1 -> Octets.u4(b, s, 17) / Math.pow(10, Octets.u1(b, s, 16));
+      default -> throw new IllegalArgumentException("earth shape " + shape
+          + " (oblate spheroid) not supported; HRRR uses 6, a sphere of radius 6371229 m");
+    };
+  }
+}
diff --git a/pipeline/src/main/java/wx/grib/HrrrVariable.java b/pipeline/src/main/java/wx/grib/HrrrVariable.java
new file mode 100644
index 0000000..040379c
--- /dev/null
+++ b/pipeline/src/main/java/wx/grib/HrrrVariable.java
@@ -0,0 +1,48 @@
+package wx.grib;
+
+/**
+ * The HRRR surface fields the station pipeline uses, identified the way GRIB2 identifies them:
+ * discipline, parameter category and number (WMO Code Table 4.2) and the fixed surface (Table 4.5).
+ * The {@code idxName} and {@code idxLevel} are how the same fields appear in NCEP's .idx inventory
+ * files, which the fetch script uses to download only these messages.
+ */
+public enum HrrrVariable {
+  TMP_2M(0, 0, 0, 103, 2.0, "TMP", "2 m above ground", "K"),
+  DPT_2M(0, 0, 6, 103, 2.0, "DPT", "2 m above ground", "K"),
+  UGRD_10M(0, 2, 2, 103, 10.0, "UGRD", "10 m above ground", "m s-1"),
+  VGRD_10M(0, 2, 3, 103, 10.0, "VGRD", "10 m above ground", "m s-1"),
+  PRES_SFC(0, 3, 0, 1, Double.NaN, "PRES", "surface", "Pa");
+
+  public final int discipline;
+  public final int category;
+  public final int number;
+  public final int surfaceType;
+  public final double surfaceValue;
+  public final String idxName;
+  public final String idxLevel;
+  public final String units;
+
+  HrrrVariable(int discipline, int category, int number, int surfaceType, double surfaceValue,
+               String idxName, String idxLevel, String units) {
+    this.discipline = discipline;
+    this.category = category;
+    this.number = number;
+    this.surfaceType = surfaceType;
+    this.surfaceValue = surfaceValue;
+    this.idxName = idxName;
+    this.idxLevel = idxLevel;
+    this.units = units;
+  }
+
+  static HrrrVariable match(int discipline, int category, int number, int surfaceType,
+                            double surfaceValue) {
+    for (HrrrVariable v : values()) {
+      if (v.discipline == discipline && v.category == category && v.number == number
+          && v.surfaceType == surfaceType
+          && (Double.isNaN(v.surfaceValue) || Math.abs(v.surfaceValue - surfaceValue) < 1e-6)) {
+        return v;
+      }
+    }
+    return null;
+  }
+}
diff --git a/pipeline/src/main/java/wx/grib/LambertConformal.java b/pipeline/src/main/java/wx/grib/LambertConformal.java
new file mode 100644
index 0000000..437363a
--- /dev/null
+++ b/pipeline/src/main/java/wx/grib/LambertConformal.java
@@ -0,0 +1,155 @@
+package wx.grib;
+
+import java.io.Serializable;
+
+/**
+ * GRIB2 grid template 3.30, Lambert conformal conic on a sphere: grid index from latitude and
+ * longitude, and the reverse. Formulas are Snyder, Map Projections: A Working Manual (USGS PP 1395),
+ * chapter 15, spherical form.
+ *
+ * <p>The grid is defined by its first point (La1, Lo1) and spacing (Dx, Dy) in projected metres, so
+ * a point's fractional grid position is its projected offset from the first point divided by the
+ * spacing. Only scanning mode 0x40 is supported (i east, j north, i fastest), which is what HRRR
+ * and most NCEP Lambert grids use; anything else is rejected rather than silently mis-indexed.
+ */
+public final class LambertConformal implements Serializable {
+
+  public final int nx;
+  public final int ny;
+  public final double la1;
+  public final double lo1;
+  public final double lov;
+  public final double latin1;
+  public final double latin2;
+  public final double dx;
+  public final double dy;
+  public final double earthRadius;
+  /** Resolution and component flags bit 0x08: U/V are relative to the grid's x/y axes. */
+  public final boolean uvRelativeToGrid;
+
+  private final double n;
+  private final double rf;  // R * F
+  private final double rho0;
+  private final double x1;
+  private final double y1;
+
+  public LambertConformal(int nx, int ny, double la1, double lo1, double lov, double latin1,
+                          double latin2, double dx, double dy, double earthRadius,
+                          boolean uvRelativeToGrid) {
+    this.nx = nx;
+    this.ny = ny;
+    this.la1 = la1;
+    this.lo1 = lo1;
+    this.lov = lov;
+    this.latin1 = latin1;
+    this.latin2 = latin2;
+    this.dx = dx;
+    this.dy = dy;
+    this.earthRadius = earthRadius;
+    this.uvRelativeToGrid = uvRelativeToGrid;
+
+    double p1 = Math.toRadians(latin1);
+    double p2 = Math.toRadians(latin2);
+    if (Math.abs(latin1 - latin2) < 1e-9) {
+      this.n = Math.sin(p1);  // tangent cone
+    } else {
+      this.n = Math.log(Math.cos(p1) / Math.cos(p2))
+          / Math.log(Math.tan(Math.PI / 4 + p2 / 2) / Math.tan(Math.PI / 4 + p1 / 2));
+    }
+    double f = Math.cos(p1) * Math.pow(Math.tan(Math.PI / 4 + p1 / 2), n) / n;
+    this.rf = earthRadius * f;
+    this.rho0 = rho(latin1);  // any fixed origin works: only offsets from the first point matter
+    double[] xy1 = project(la1, lo1);
+    this.x1 = xy1[0];
+    this.y1 = xy1[1];
+  }
+
+  /** The cone constant n; also the factor in the wind-rotation angle. */
+  public double coneConstant() {
+    return n;
+  }
+
+  private double rho(double latDeg) {
+    return rf / Math.pow(Math.tan(Math.PI / 4 + Math.toRadians(latDeg) / 2), n);
+  }
+
+  /** Longitude difference from LoV, wrapped to [-180, 180) so 264.6 and -95.4 agree. */
+  static double deltaLon(double lonDeg, double lovDeg) {
+    double d = (lonDeg - lovDeg) % 360.0;
+    if (d < -180.0) {
+      d += 360.0;
+    } else if (d >= 180.0) {
+      d -= 360.0;
+    }
+    return d;
+  }
+
+  private double[] project(double latDeg, double lonDeg) {
+    double theta = n * Math.toRadians(deltaLon(lonDeg, lov));
+    double r = rho(latDeg);
+    return new double[] {r * Math.sin(theta), rho0 - r * Math.cos(theta)};
+  }
+
+  /** Fractional grid position {i, j}; i = 0, j = 0 is the first grid point. */
+  public double[] fractionalIndex(double latDeg, double lonDeg) {
+    double[] xy = project(latDeg, lonDeg);
+    return new double[] {(xy[0] - x1) / dx, (xy[1] - y1) / dy};
+  }
+
+  /** Nearest grid point {i, j}, or null when the point falls outside the grid. */
+  public int[] nearest(double latDeg, double lonDeg) {
+    double[] f = fractionalIndex(latDeg, lonDeg);
+    int i = (int) Math.round(f[0]);
+    int j = (int) Math.round(f[1]);
+    if (i < 0 || i >= nx || j < 0 || j >= ny) {
+      return null;
+    }
+    return new int[] {i, j};
+  }
+
+  /** Flat index into the data array for scanning mode 0x40 (i fastest, south row first). */
+  public int flatIndex(int i, int j) {
+    return j * nx + i;
+  }
+
+  /** Latitude and longitude {lat, lon in [-180, 180)} of grid point (i, j). */
+  public double[] latLon(int i, int j) {
+    double x = x1 + i * dx;
+    double y = y1 + j * dy;
+    double dyFromApex = rho0 - y;
+    double r = Math.copySign(Math.hypot(x, dyFromApex), n);
+    double theta = Math.atan2(Math.signum(n) * x, Math.signum(n) * dyFromApex);
+    double lon = lov + Math.toDegrees(theta / n);
+    double lat = Math.toDegrees(2 * Math.atan(Math.pow(rf / r, 1 / n)) - Math.PI / 2);
+    return new double[] {lat, deltaLon(lon, 0.0)};
+  }
+
+  /** Great-circle distance in km on this grid's sphere. */
+  public double distanceKm(double lat1, double lon1, double lat2, double lon2) {
+    double p1 = Math.toRadians(lat1);
+    double p2 = Math.toRadians(lat2);
+    double dp = p2 - p1;
+    double dl = Math.toRadians(lon2 - lon1);
+    double a = Math.sin(dp / 2) * Math.sin(dp / 2)
+        + Math.cos(p1) * Math.cos(p2) * Math.sin(dl / 2) * Math.sin(dl / 2);
+    return 2 * earthRadius / 1000.0 * Math.asin(Math.min(1.0, Math.sqrt(a)));
+  }
+
+  /**
+   * Rotates grid-relative U/V to earth-relative (east/north) at the given longitude.
+   *
+   * <p>The grid's y axis points to true north only along LoV; elsewhere it is turned by
+   * angle = n * (lon - LoV). Wind speed is unchanged by the rotation; direction is not. On HRRR
+   * (n = sin 38.5 = 0.62, LoV = 97.5 W) treating grid-relative U/V as east/north turns directions
+   * by about 1 degree in Houston, 4 degrees in Denver and over 20 degrees at the grid's corners.
+   */
+  public double[] toEarthRelative(double uGrid, double vGrid, double lonDeg) {
+    if (!uvRelativeToGrid) {
+      return new double[] {uGrid, vGrid};
+    }
+    double angle = n * Math.toRadians(deltaLon(lonDeg, lov));
+    double c = Math.cos(angle);
+    double s = Math.sin(angle);
+    return new double[] {c * uGrid + s * vGrid, -s * uGrid + c * vGrid};
+  }
+}
diff --git a/pipeline/src/main/java/wx/grib/NetcdfUnpacker.java b/pipeline/src/main/java/wx/grib/NetcdfUnpacker.java
new file mode 100644
index 0000000..d390f73
--- /dev/null
+++ b/pipeline/src/main/java/wx/grib/NetcdfUnpacker.java
@@ -0,0 +1,70 @@
+package wx.grib;
+
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+import ucar.nc2.grib.grib2.Grib2Record;
+import ucar.nc2.grib.grib2.Grib2RecordScanner;
+import ucar.unidata.io.RandomAccessFile;
+
+/**
+ * Unpacks GRIB2 data sections with netCDF-Java (Unidata), matched one-to-one with the messages
+ * {@link Grib2Scanner} found. Unpacking complex packing with spatial differencing (template 5.3,
+ * what HRRR uses) is exactly the kind of code not to write yourself, so this is the one place the
+ * pipeline depends on a GRIB library.
+ *
+ * <p>netCDF-Java reads through its own RandomAccessFile, so the bytes are written to a temporary
+ * file first. Use with try-with-resources so the file is closed and deleted.
+ */
+public final class NetcdfUnpacker implements AutoCloseable {
+
+  private final Path tmp;
+  private final RandomAccessFile raf;
+  private final Map<Grib2Message, Grib2Record> records = new IdentityHashMap<>();
+
+  public NetcdfUnpacker(byte[] data, List<Grib2Message> messages) throws IOException {
+    this.tmp = Files.createTempFile("wx-grib-", ".grib2");
+    Files.write(tmp, data);
+    this.raf = new RandomAccessFile(tmp.toString(), "r");
+    List<Grib2Record> found = new ArrayList<>();
+    Grib2RecordScanner scanner = new Grib2RecordScanner(raf);
+    while (scanner.hasNext()) {
+      found.add(scanner.next());
+    }
+    if (found.size() != messages.size()) {
+      close();
+      throw new IOException("netCDF-Java found " + found.size() + " GRIB2 records, the scanner found "
+          + messages.size() + "; refusing to pair them up");
+    }
+    for (int k = 0; k < found.size(); k++) {
+      records.put(messages.get(k), found.get(k));
+    }
+  }
+
+  /** All grid values of {@code m}, scanning order 0x40 (i fastest, south row first), NaN if masked. */
+  public float[] unpack(Grib2Message m) {
+    Grib2Record r = records.get(m);
+    if (r == null) {
+      throw new IllegalArgumentException("message at byte " + m.offset() + " was not in this file");
+    }
+    try {
+      return r.readData(raf);
+    } catch (IOException e) {
+      throw new UncheckedIOException(e);
+    }
+  }
+
+  @Override
+  public void close() throws IOException {
+    try {
+      raf.close();
+    } finally {
+      Files.deleteIfExists(tmp);
+    }
+  }
+}
diff --git a/pipeline/src/main/java/wx/grib/Octets.java b/pipeline/src/main/java/wx/grib/Octets.java
new file mode 100644
index 0000000..5e1a695
--- /dev/null
+++ b/pipeline/src/main/java/wx/grib/Octets.java
@@ -0,0 +1,61 @@
+package wx.grib;
+
+/**
+ * Reads GRIB2 fixed-width fields. GRIB2 octet numbers are 1-based within each section, the way
+ * the WMO tables print them, so callers pass the section start and the octet number exactly as in
+ * the template tables and no off-by-one arithmetic leaks into the parsers.
+ *
+ * <p>GRIB2 trap, the equivalent of COMP-3's sign nibble: signed integers are sign-and-magnitude,
+ * not two's complement. The top bit is the sign and the remaining bits the magnitude, so 0x80000001
+ * is -1, not -2147483647. Reading one as a Java int gives nonsense latitudes south of the equator
+ * and wrong negative scale factors.
+ */
+final class Octets {
+
+  private Octets() {}
+
+  static int u1(byte[] b, int sectionStart, int octet) {
+    return b[sectionStart + octet - 1] & 0xFF;
+  }
+
+  static int u2(byte[] b, int sectionStart, int octet) {
+    return (u1(b, sectionStart, octet) << 8) | u1(b, sectionStart, octet + 1);
+  }
+
+  static long u4(byte[] b, int sectionStart, int octet) {
+    return ((long) u2(b, sectionStart, octet) << 16) | u2(b, sectionStart, octet + 2);
+  }
+
+  static long u8(byte[] b, int sectionStart, int octet) {
+    return (u4(b, sectionStart, octet) << 32) | u4(b, sectionStart, octet + 4);
+  }
+
+  /** 2-octet sign-and-magnitude integer. */
+  static int s2(byte[] b, int sectionStart, int octet) {
+    int raw = u2(b, sectionStart, octet);
+    int magnitude = raw & 0x7FFF;
+    return (raw & 0x8000) != 0 ? -magnitude : magnitude;
+  }
+
+  /** 4-octet sign-and-magnitude integer. */
+  static long s4(byte[] b, int sectionStart, int octet) {
+    long raw = u4(b, sectionStart, octet);
+    long magnitude = raw & 0x7FFF_FFFFL;
+    return (raw & 0x8000_0000L) != 0 ? -magnitude : magnitude;
+  }
+
+  /** 4-octet IEEE 754 single precision, big-endian (Section 5 reference value). */
+  static float ieee32(byte[] b, int sectionStart, int octet) {
+    return Float.intBitsToFloat((int) u4(b, sectionStart, octet));
+  }
+
+  /** True when every octet of the field is 0xFF, GRIB's "missing" marker. */
+  static boolean allOnes(byte[] b, int sectionStart, int octet, int length) {
+    for (int k = 0; k < length; k++) {
+      if (u1(b, sectionStart, octet + k) != 0xFF) {
+        return false;
+      }
+    }
+    return true;
+  }
+}
